{
  "expo": {
    "name": "Ask Beth",
    "slug": "ask-beth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/f8290115-19d6-440b-b69a-ffb7d6ee90ef.jpeg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/f8290115-19d6-440b-b69a-ffb7d6ee90ef.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.askbeth.app",
      "icon": "./assets/images/f8290115-19d6-440b-b69a-ffb7d6ee90ef.jpeg",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/f8290115-19d6-440b-b69a-ffb7d6ee90ef.jpeg",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/f8290115-19d6-440b-b69a-ffb7d6ee90ef.jpeg",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/images/f8290115-19d6-440b-b69a-ffb7d6ee90ef.jpeg",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "package": "com.askbeth.app"
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-video",
      "react-native-reanimated",
      "react-native-edge-to-edge"
    ],
    "newArchEnabled": true,
    "scheme": "askbeth",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "revenueCatApiKeyIos": "",
      "revenueCatApiKeyAndroid": "",
      "revenueCatEntitlementId": "pro"
    }
  }
}